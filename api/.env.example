# Sao chép thành .env rồi sửa giá trị. Không commit .env (NFR-SEC-06).

# MySQL chạy bằng docker compose (khuyến nghị cho demo chính thức).
# Database campushub_v3 được tạo tự động bởi: python scripts/init_db.py
DATABASE_URL=mysql+pymysql://root:rootpassword@127.0.0.1:3306/campushub_v3
# Hoặc SQLite (không cần Docker):
# DATABASE_URL=sqlite:///./campushub_dev.db

# Bắt buộc, tối thiểu 32 ký tự. Tạo bằng: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# Origin của frontend, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000

# File bài nộp
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=20

# Số ngày được gửi phúc khảo kể từ lúc điểm hiện (BR-REG-01)
REGRADE_WINDOW_DAYS=7

# Dùng cho docker-compose.yml
DB_PASSWORD=rootpassword
